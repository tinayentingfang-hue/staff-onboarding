# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed once, temporarily, to run `node --env-file=.env.local scripts/seed.mjs`.
# This key bypasses all security rules — never put it in NEXT_PUBLIC_*, never
# commit it, and remove it from this file again after seeding.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
